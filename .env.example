# Supabase Project URL & Public Anon Key (Dapat dilihat di Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Secret Service Role Key (Wajib untuk Server Admin API membuat akun tanpa konfirmasi email)
# PERINGATAN: JANGAN beri awalan NEXT_PUBLIC_! Key ini hanya untuk server backend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# WhatsApp Gateway (Fonnte / Wablas) - Opsional jika diatur lewat Dashboard Pengaturan
WHATSAPP_API_TOKEN=your-whatsapp-gateway-token-here

# Midtrans Payment Gateway - Opsional jika diatur lewat Dashboard Pengaturan
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key-here
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key-here
MIDTRANS_IS_PRODUCTION=false
